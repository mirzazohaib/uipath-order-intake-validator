# ==========================================================
# UiPath Order Intake Validator
# ==========================================================

# --------------------------
# UiPath local/runtime files
# --------------------------
**/.local/
**/.settings/
**/.tmh/
**/.objects/
**/.entities/
**/.templates/

# Keep project metadata required to open the project
!**/.project/

# --------------------------
# Build / temporary files
# --------------------------
bin/
obj/
temp/

# --------------------------
# Logs
# --------------------------
*.log
Execution.log
RobotLogs/

# --------------------------
# Generated output files
# --------------------------
output/*.xlsx
!output/.gitkeep

# --------------------------
# Excel temporary lock files
# --------------------------
~$*.xlsx
~$*.xls
~$*.xlsm

# --------------------------
# Visual Studio Code
# --------------------------
.vscode/settings.json

# --------------------------
# JetBrains
# --------------------------
.idea/

# --------------------------
# Operating System files
# --------------------------
.DS_Store
Thumbs.db

# --------------------------
# User-specific files
# --------------------------
*.user
*.local

# --------------------------
# UiPath packages
# --------------------------
*.nupkg